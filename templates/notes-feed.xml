<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>

<title>$pagetitle$</title>
<description>$description-meta$</description>
<link>$base-uri$/notes/</link>
<language>ru</language>
<generator>pandoc</generator>
<lastBuildDate>$date-rfc$</lastBuildDate>

<atom:link href="$base-uri$/notes/feed.xml" rel="self" type="application/rss+xml" />

$for(notes)$
$for(notes.articles)$
<item>
    <title>$notes.articles.title$</title>
    <description><![CDATA[$notes.articles.description$]]></description>
    <link>$base-uri$/notes/$notes.articles.file$.html</link>
    <pubDate>$notes.articles.date-rfc$</pubDate>
    <guid isPermaLink="false">$notes.articles.guid$</guid>
</item>
$endfor$
$endfor$

</channel>
</rss>
